{%- set slug_parts = repo_slug.replace('_', '-').replace('.', '-').split('-') | reject('equalto', '') | list -%}
{%- set id_prefix = ((slug_parts | map('first') | join) if slug_parts | length > 1 else repo_slug) | upper -%}
# {{ repo_slug }} in System4D terms.
# The root of a {{ company_name }} monorepo.
# Packages under packages/ and apps under apps/ inherit it. Written for the
# agents that work in and beside this repo: read it before changing what the
# monorepo does or how. README.md, AGENTS.md and the package and app READMEs
# hold the long form; keep this file true to the shipped code.
#
# tpl-monorepo rendered the name, the package manager, and the boundaries and
# dependencies every generated monorepo shares from its copier answers. A value
# that starts with "FILL IN" is an instruction, not a fact: until it is
# replaced it says nothing about this repo. The agent that generates or adopts
# the monorepo replaces each one from its own sources (the task that created
# it, README.md, docs/org_context/, packages/, apps/, tests/), adds entries
# where the monorepo has more, empties a list ([]) where it has none, and
# renames the {{ id_prefix }}- ids if the monorepo has a settled short name.
# grep -n "FILL IN" ontology/src/system4d.yaml lists what is still open.
ontology:
  system4d:
    name: "{{ repo_slug }}"
    version: "0.1"
    container:
      boundary:
        in_scope:
          - "FILL IN from README.md, packages/ and apps/: what this monorepo implements, one line per package or app"
        out_of_scope:
          - "Task, direction, decision and evidence state: Agent Kernel (ak) owns it; docs and governance/task-scopes/ snapshots are projections"
          - "Shared vocabulary: concepts come from the core and company ontology layers in ontology/manifest.yaml; the monorepo defines its own only where those have none"
          - "FILL IN: what a reader could expect here that this monorepo does not do, and which repo or tool does it instead"
      constraints:
        - "Workspace package manager: {{ package_manager }}; each package and app declares its own language"
        - "FILL IN: runtime, platform and resource constraints the code must respect (versions, network exposure, storage, secrets)"
      edges:
        - name: "FILL IN: one entry per system this monorepo exchanges data or commands with"
          direction: "FILL IN: in, out or bi"
          protocol: "FILL IN: http, kafka, file, cli or another transport"
          system: "FILL IN: the system on the other side"
          contract: "FILL IN: the path or link of the spec, schema or doc that defines the exchange"
      dependencies:
        - name: "Agent Kernel (ak)"
          type: "runtime"
          note: "Tasks, direction, decisions and evidence for this monorepo live in AK, not in markdown"
        - name: "core/ontology-kernel and {{ company_slug }}/ontology"
          type: "build"
          note: "The core and company ontology layers, pinned in ontology/manifest.yaml"
        - name: "core/rocs-cli"
          type: "build"
          note: "Runs the ontology checks through ./scripts/rocs.sh, which pins the release it accepts"
        - name: "engineering-core"
          type: "build"
          note: "The shared engineering guidance: policy/engineering-lane.json points at it, docs/engineering.local.md holds the local overrides"
        - name: "FILL IN: one entry per further runtime, build or infra dependency the code needs"
          type: "FILL IN: runtime, build or infra"
          note: "FILL IN: why the monorepo needs it"
      anti_goals:
        - "FILL IN: a tempting feature or direction this monorepo deliberately rejects, and why"
    compass:
      drivers:
        - "FILL IN from docs/org_context/ and the task that created this monorepo: the situation that calls for it now"
      outcomes:
        - "FILL IN: what someone can do once this monorepo works"
      tradeoffs:
        - decision: "FILL IN: a design choice that had real alternatives, such as what becomes a package and what an app"
          chosen: "FILL IN: the alternative taken"
          because: "FILL IN: why, citing the decision record where one exists"
    engine:
      triggers:
        - "FILL IN: what starts work in this system (a command, a request, a schedule, an event)"
      states:
        - name: "FILL IN: a state the main object of this monorepo passes through"
          meaning: "FILL IN: what holds while it is in that state"
      invariants:
        - id: "{{ id_prefix }}-INV-001"
          statement: "FILL IN: a rule that must always hold across packages and apps, stated so that a test can check it"
          enforcement: "FILL IN: test, db or policy, then the code and tests that enforce it (for example: test: packages/ledger/src/ledger.py, packages/ledger/tests/test_ledger.py)"
      lifecycle:
        - "FILL IN: the main flow from trigger to result, one step per entry"
    fog:
      assumptions:
        - id: "{{ id_prefix }}-A-001"
          statement: "FILL IN: something the design relies on that nobody has proven"
          how_to_validate: "FILL IN: the command or observation that would confirm or refute it"
      risks:
        - id: "{{ id_prefix }}-R-001"
          statement: "FILL IN: what could go wrong, and how an agent would notice"
          mitigation: "FILL IN: what reduces it, pointing at code, tests or an invariant"
      exceptions:
        - id: "REPO-E-INCIDENT"
          statement: "Incident hotfix allowed"
          reason: "Record Exception immediately and Debt immediately"
      debt:
        - id: "{{ id_prefix }}-D-001"
          statement: "FILL IN: a known shortcut or gap in the shipped code"
          payoff_plan: "FILL IN: when and how it gets paid off"
