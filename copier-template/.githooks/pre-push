#!/usr/bin/env sh
set -eu

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$repo_root/scripts/ci/full.sh" </dev/null
# Company-owned extension point (never touched by template refresh); it receives
# git's pre-push arguments and ref lines on stdin.
exec "$repo_root/scripts/lib/run-local-hook.sh" local/githooks/pre-push "$@"
